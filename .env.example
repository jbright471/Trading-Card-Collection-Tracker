# Optional Discord webhook for wishlist and collection alerts.
DISCORD_WEBHOOK_URL=

# Optional local PIN for collection-changing actions and private downloads.
TCG_TRACKER_PIN=
TCG_TRACKER_SECRET_KEY=

# Provider pacing and retry settings.
REQUEST_DELAY=0.75
SCRYFALL_MIN_INTERVAL_SECONDS=0.65
HTTP_MAX_RETRIES=4
