# Optional alerting
DISCORD_WEBHOOK_URL=
ALERT_THRESHOLD_PERCENT=10
WISHLIST_COOLDOWN_DAYS=7

# API pacing and retry settings
REQUEST_DELAY=0.75
SCRYFALL_MIN_INTERVAL_SECONDS=0.65
HTTP_MAX_RETRIES=4
HTTP_BACKOFF_SECONDS=1.0
HTTP_BACKOFF_MAX_SECONDS=20.0

# History retention
HISTORY_RETENTION_DAYS=90
